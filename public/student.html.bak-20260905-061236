<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>داشبورد دانش‌آموز | باغچهٔ درس</title>
<link rel="stylesheet" href="/assets/style.css">
<script src="/assets/auth.js"></script>
<script src="/assets/api.js"></script>
<script src="/assets/date-fa.js"></script>

<style>
* { box-sizing: border-box; }
body { margin: 0; font-family: 'Vazirmatn', Tahoma, sans-serif; background: #f3f7f2; color: #26332b; }
.container { max-width: 1200px; margin: auto; padding: 20px; }

/* نوار بالا */
.topbar {
  background: #fff;
  border-radius: 20px;
  padding: 14px 20px;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4px 15px #00000008;
  flex-wrap: wrap;
  gap: 10px;
}
.brand { font-size: 20px; font-weight: 900; color: #3F7A52; display: flex; align-items: center; gap: 8px; }
.topbar-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.nav-link {
  text-decoration: none;
  color: #26332b;
  padding: 8px 14px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.2s;
  cursor: pointer;
}
.nav-link:hover { background: #e3f0e6; color: #3F7A52; }
.nav-link.active { background: #3F7A52; color: #fff; }
.btn-logout {
  background: #fdecd8;
  color: #e2725b;
  border: none;
  padding: 8px 16px;
  border-radius: 10px;
  font-weight: bold;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
}

/* هدر پروفایل */
.profile-header {
  background: linear-gradient(135deg, #3F7A52 0%, #5B9E6E 100%);
  border-radius: 24px;
  padding: 24px;
  display: flex;
  align-items: center;
  gap: 18px;
  color: #fff;
  margin-bottom: 20px;
  position: relative;
}
.avatar {
  width: 70px; height: 70px;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: grid;
  place-items: center;
  font-size: 36px;
  cursor: pointer;
  position: relative;
}
.avatar:hover::after {
  content: '✏️';
  position: absolute;
  bottom: 0;
  right: 0;
  background: #fff;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  font-size: 14px;
}
.profile-header h1 { margin: 0; font-size: 22px; }
.profile-header p { margin: 6px 0 0; opacity: 0.9; font-size: 14px; }
.profile-stats {
  position: absolute;
  left: 24px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  gap: 20px;
}
.profile-stat {
  text-align: center;
}
.profile-stat b {
  display: block;
  font-size: 24px;
  font-weight: 900;
}
.profile-stat span {
  font-size: 12px;
  opacity: 0.9;
}

/* گرید اصلی */
.dashboard-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

/* کارت‌ها */
.card {
  background: #fff;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 7px 22px #00000008;
  margin-bottom: 20px;
}
.card h2 {
  font-size: 17px;
  margin: 0 0 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #3F7A52;
}

/* جایزه روزانه */
.daily-reward {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s;
}
.daily-reward:hover { transform: scale(1.02); }
.daily-reward.claimed {
  background: linear-gradient(135deg, #90EE90 0%, #32CD32 100%);
  cursor: default;
}
.daily-reward h3 { margin: 0; font-size: 18px; }
.daily-reward p { margin: 4px 0 0; font-size: 14px; opacity: 0.9; }
.reward-btn {
  background: #fff;
  color: #FFA500;
  border: none;
  padding: 10px 20px;
  border-radius: 12px;
  font-weight: bold;
  cursor: pointer;
  font-family: inherit;
}
.reward-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* اعلان‌ها */
.notifications-list {
  max-height: 300px;
  overflow-y: auto;
}
.notification-item {
  padding: 12px;
  border-radius: 12px;
  margin-bottom: 8px;
  background: #f8faf9;
  border-right: 4px solid #3F7A52;
  cursor: pointer;
  transition: all 0.2s;
}
.notification-item:hover { background: #e3f0e6; }
.notification-item.unread { background: #fff4cc; border-right-color: #FFD700; }
.notification-item small { color: #718075; display: block; margin-top: 4px; font-size: 12px; }

/* چالش روزانه */
.challenge-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 20px;
}
.challenge-card h3 { margin: 0 0 8px; font-size: 18px; }
.challenge-card p { margin: 0 0 16px; font-size: 14px; opacity: 0.9; }
.challenge-btn {
  background: #fff;
  color: #764ba2;
  border: none;
  padding: 10px 20px;
  border-radius: 12px;
  font-weight: bold;
  cursor: pointer;
  font-family: inherit;
}
.challenge-btn:disabled { opacity: 0.6; cursor: not-allowed; }

/* یادداشت والدین */
.parent-note {
  background: #fff4cc;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 12px;
  border-right: 4px solid #FFD700;
}
.parent-note small { color: #718075; display: block; margin-top: 6px; font-size: 12px; }

/* های‌فایو */
.highfive-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: #f8faf9;
  border-radius: 12px;
  margin-bottom: 8px;
}
.highfive-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #e3f0e6;
  display: grid;
  place-items: center;
  font-size: 20px;
}
.highfive-content { flex: 1; }
.highfive-content b { font-size: 14px; }
.highfive-content small { color: #718075; font-size: 12px; display: block; margin-top: 2px; }
.send-highfive-btn {
  background: #3F7A52;
  color: #fff;
  border: none;
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 12px;
  cursor: pointer;
  font-family: inherit;
}

/* تکالیف */
.task {
  border: 1px solid #e6ebe6;
  border-radius: 15px;
  padding: 14px;
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: 0.2s;
  cursor: pointer;
}
.task:hover { background: #f8faf9; border-color: #3F7A52; }
.task small { color: #718075; display: block; margin-top: 4px; font-size: 12px; }
.status {
  background: #e5f3e8;
  color: #34734b;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: bold;
}
.status.warn { background: #fff2d7; color: #a46b00; }
.status.urgent { background: #fdecd8; color: #e2725b; }

/* مهارت‌ها */
.skill { margin-bottom: 15px; }
.skill-head { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 6px; }
.progress { height: 10px; background: #edf1ed; border-radius: 99px; overflow: hidden; }
.progress div { height: 100%; background: #4c8b61; border-radius: 99px; transition: width 1s ease; }

/* گیاه */
.plant {
  text-align: center;
  background: #edf6ef;
  border-radius: 20px;
  padding: 24px;
}
.plant .tree { font-size: 95px; display: block; margin-bottom: 10px; }
.plant h3 { margin: 8px 0; font-size: 18px; }
.plant p { color: #718075; font-size: 13px; line-height: 1.6; }

/* دستاوردها */
.badges { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
.badge { width: 70px; text-align: center; font-size: 11px; color: #718075; }
.badge div { width: 58px; height: 58px; margin: auto; border-radius: 50%; background: #fff4cc; display: grid; place-items: center; font-size: 28px; margin-bottom: 6px; }

/* دکمه‌های اکشن */
.actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 16px; }
.action-btn {
  border: 1px solid #e3e9e3;
  border-radius: 14px;
  padding: 14px;
  background: #fafcf9;
  text-align: center;
  cursor: pointer;
  font-weight: bold;
  font-size: 14px;
  transition: 0.2s;
  text-decoration: none;
  color: #26332b;
  display: block;
}
.action-btn:hover { background: #e3f0e6; border-color: #3F7A52; }

/* مودال */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal.active { display: flex; }
.modal-content {
  background: #fff;
  border-radius: 20px;
  padding: 24px;
  max-width: 500px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
}
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.modal-header h3 { margin: 0; color: #3F7A52; }
.close-modal { background: none; border: none; font-size: 24px; cursor: pointer; color: #718075; }

/* ریسپانسیو */
@media(max-width: 750px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .profile-stats { position: static; transform: none; margin-top: 16px; display: flex; justify-content: space-around; }
  .topbar { flex-direction: column; align-items: stretch; }
  .topbar-actions { justify-content: center; }
}
</style>
</head>

<body>
<div class="container">

  <!-- نوار بالا -->
  <nav class="topbar">
    <div class="brand">🌱 باغچهٔ درس</div>
    <div class="topbar-actions">
      <span class="nav-link active" onclick="scrollToSection('dashboard')"> داشبورد</span>
      <span class="nav-link" onclick="scrollToSection('tasks')">📚 تکالیف</span>
      <span class="nav-link" onclick="scrollToSection('challenges')">🎯 چالش</span>
      <span class="nav-link" onclick="scrollToSection('highfives')">👋 های‌فایو</span>
      <span class="nav-link" onclick="scrollToSection('parent')">👨‍👩‍👦 والدین</span>
      <span class="nav-link" onclick="openProfileModal()">👤 پروفایل</span>
      <button class="btn-logout" onclick="logout()">🚪 خروج</button>
    </div>
  </nav>

  <!-- هدر پروفایل -->
  <header class="profile-header">
    <div class="avatar" id="studentAvatar" onclick="openProfileModal()">🧒</div>
    <div>
      <h1 id="studentName">در حال بارگذاری...</h1>
      <p id="studentClass">...</p>
    </div>
    <div class="profile-stats">
      <div class="profile-stat">
        <b id="statGrowthPoints">۰</b>
        <span>امتیاز رشد</span>
      </div>
      <div class="profile-stat">
        <b id="statStreak">۰</b>
        <span>روز متوالی</span>
      </div>
    </div>
  </header>

  <!-- جایزه روزانه -->
  <div class="daily-reward" id="dailyRewardCard" onclick="claimDailyReward()">
    <div>
      <h3>🎁 جایزه روزانه</h3>
      <p id="rewardStatus">برای دریافت جایزه کلیک کن</p>
    </div>
    <button class="reward-btn" id="rewardBtn">دریافت</button>
  </div>

  <!-- گرید اصلی -->
  <div class="dashboard-grid">
    <div>
      <!-- اعلان‌ها -->
      <div class="card" id="notificationsSection">
        <h2>🔔 اعلان‌ها <span id="notifCount" style="background:#e2725b;color:#fff;padding:2px 8px;border-radius:999px;font-size:12px;margin-right:8px;">۰</span></h2>
        <div class="notifications-list" id="notificationsList">
          <div style="text-align:center; padding:20px; color:#718075;">در حال بارگذاری...</div>
        </div>
      </div>

      <!-- چالش روزانه -->
      <div class="challenge-card" id="challengesSection">
        <h3 id="challengeTitle">🎯 چالش امروز</h3>
        <p id="challengeDesc">در حال بارگذاری...</p>
        <button class="challenge-btn" id="challengeBtn" onclick="completeChallenge()">انجام دادم ✓</button>
      </div>

      <!-- تکالیف -->
      <div class="card" id="tasksSection">
        <h2> تکالیف من</h2>
        <div id="tasksList">
          <div style="text-align:center; padding:20px; color:#718075;">در حال دریافت تکالیف...</div>
        </div>
      </div>

      <!-- تحلیل یادگیری -->
      <div class="card">
        <h2>🧠 تحلیل یادگیری</h2>
        <div id="skillsList">
          <div class="skill">
            <div class="skill-head"><b>در حال بارگذاری...</b><span>۰٪</span></div>
            <div class="progress"><div style="width:0%"></div></div>
          </div>
        </div>
        <div class="actions">
          <a href="#practice" class="action-btn">🤖 تمرین پیشنهادی</a>
          <a href="#diary" class="action-btn" onclick="openDiaryModal()"> دفترچه باغچه</a>
        </div>
      </div>
    </div>

    <div>
      <!-- یادداشت والدین -->
      <div class="card" id="parentSection">
        <h2>👨👩‍👦 یادداشت والدین</h2>
        <div id="parentNotesList">
          <div style="text-align:center; padding:20px; color:#718075;">در حال بارگذاری...</div>
        </div>
      </div>

      <!-- های‌فایو -->
      <div class="card" id="highfivesSection">
        <h2>👋 های‌فایو</h2>
        <div id="highfivesList">
          <div style="text-align:center; padding:20px; color:#718075;">در حال بارگذاری...</div>
        </div>
        <button class="action-btn" style="margin-top:12px;" onclick="openHighFiveModal()"> ارسال های‌فایو</button>
      </div>

      <!-- گیاه -->
      <div class="plant">
        <span class="tree" id="plantIcon">🌱</span>
        <h3 id="plantStage">رشد یادگیری تو: «جوانه»</h3>
        <p>با تمرین و پیشرفت، باغچهٔ یادگیریت رشد می‌کند.</p>
      </div>

      <!-- دستاوردها -->
      <div class="card">
        <h2> دستاوردها</h2>
        <div class="badges" id="badgesList"></div>
      </div>
    </div>
  </div>

</div>

<!-- مودال پروفایل -->
<div class="modal" id="profileModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>👤 پروفایل من</h3>
      <button class="close-modal" onclick="closeModal('profileModal')">×</button>
    </div>
    <div id="profileContent" style="text-align:center;">
      <div style="font-size:80px; margin-bottom:10px;" id="profileAvatar">🧒</div>
      <h3 id="profileName">-</h3>
      <p style="color:#718075;" id="profileUsername">-</p>
      <div style="margin-top:20px;">
        <div class="stat" style="display:inline-block; margin:5px;">
          <b id="profileGrowthPoints">۰</b>
          <span>امتیاز رشد</span>
        </div>
      </div>
      <div style="margin-top:20px;">
        <label style="display:block; margin-bottom:10px; font-weight:bold;">تغییر آواتار:</label>
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
          <button onclick="changeAvatar('🧒')" style="font-size:30px; padding:10px; border:2px solid #e3e9e3; border-radius:12px; background:#fff; cursor:pointer;">🧒</button>
          <button onclick="changeAvatar('🦊')" style="font-size:30px; padding:10px; border:2px solid #e3e9e3; border-radius:12px; background:#fff; cursor:pointer;"></button>
          <button onclick="changeAvatar('🐼')" style="font-size:30px; padding:10px; border:2px solid #e3e9e3; border-radius:12px; background:#fff; cursor:pointer;"></button>
          <button onclick="changeAvatar('🐱')" style="font-size:30px; padding:10px; border:2px solid #e3e9e3; border-radius:12px; background:#fff; cursor:pointer;">🐱</button>
          <button onclick="changeAvatar('🐶')" style="font-size:30px; padding:10px; border:2px solid #e3e9e3; border-radius:12px; background:#fff; cursor:pointer;">🐶</button>
          <button onclick="changeAvatar('🦁')" style="font-size:30px; padding:10px; border:2px solid #e3e9e3; border-radius:12px; background:#fff; cursor:pointer;">🦁</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- مودال ارسال های‌فایو -->
<div class="modal" id="highfiveModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>👋 ارسال های‌فایو</h3>
      <button class="close-modal" onclick="closeModal('highfiveModal')">×</button>
    </div>
    <div id="classmatesList">
      <div style="text-align:center; padding:20px; color:#718075;">در حال بارگذاری...</div>
    </div>
  </div>
</div>

<!-- مودال دفترچه باغچه -->
<div class="modal" id="diaryModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>📔 دفترچه باغچه</h3>
      <button class="close-modal" onclick="closeModal('diaryModal')">×</button>
    </div>
    <div id="diaryContent">
      <div style="text-align:center; padding:20px; color:#718075;">در حال بارگذاری...</div>
    </div>
  </div>
</div>

<script>
  const user = requireAuth(['student']);

  if (user) {
    document.getElementById('studentName').textContent = `سلام، ${user.fullName} 👋`;
    document.getElementById('studentClass').textContent = `کلاس ${user.className || 'نامشخص'} · باغچهٔ درس`;
    if (user.avatar) document.getElementById('studentAvatar').textContent = user.avatar;
  }

  function toFa(n) { return String(n).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]); }

  function scrollToSection(sectionId) {
    const element = document.getElementById(sectionId + 'Section');
    if (element) {
      element.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function openModal(modalId) {
    document.getElementById(modalId).classList.add('active');
  }

  function closeModal(modalId) {
    document.getElementById(modalId).classList.remove('active');
  }

  function openProfileModal() {
    loadProfile();
    openModal('profileModal');
  }

  function openHighFiveModal() {
    loadClassmates();
    openModal('highfiveModal');
  }

  function openDiaryModal() {
    loadDiary();
    openModal('diaryModal');
  }

  async function changeAvatar(avatar) {
    try {
      await apiFetch('/student/update-avatar', { method: 'POST', body: { avatar } });
      document.getElementById('studentAvatar').textContent = avatar;
      document.getElementById('profileAvatar').textContent = avatar;
      alert('آواتار تغییر کرد! ✅');
    } catch (e) {
      alert('خطا در تغییر آواتار: ' + e.message);
    }
  }

  async function loadProfile() {
    try {
      const data = await apiFetch('/account/get-profile');
      document.getElementById('profileAvatar').textContent = data.avatar || '';
      document.getElementById('profileName').textContent = data.full_name;
      document.getElementById('profileUsername').textContent = data.username;
      document.getElementById('profileGrowthPoints').textContent = toFa(data.growth_points || 0);
    } catch (e) {
      console.error('Error loading profile:', e);
    }
  }

  async function claimDailyReward() {
    try {
      const data = await apiFetch('/student/claim-reward', { method: 'POST' });
      document.getElementById('rewardStatus').textContent = 'جایزه دریافت شد! 🎉';
      document.getElementById('rewardBtn').textContent = '✓ دریافت شد';
      document.getElementById('rewardBtn').disabled = true;
      document.getElementById('dailyRewardCard').classList.add('claimed');
      alert('جایزه روزانه دریافت شد! +' + toFa(data.reward || 10) + ' امتیاز');
    } catch (e) {
      if (e.message.includes('already')) {
        document.getElementById('rewardStatus').textContent = 'امروز جایزه گرفتی! فردا بیا 👍';
        document.getElementById('rewardBtn').textContent = '✓ دریافت شد';
        document.getElementById('rewardBtn').disabled = true;
        document.getElementById('dailyRewardCard').classList.add('claimed');
      } else {
        alert('خطا: ' + e.message);
      }
    }
  }

  async function completeChallenge() {
    try {
      await apiFetch('/student/complete-daily-challenge', { method: 'POST' });
      document.getElementById('challengeBtn').textContent = '✓ انجام شد';
      document.getElementById('challengeBtn').disabled = true;
      alert('آفرین! چالش امروز را کامل کردی! ');
    } catch (e) {
      alert('خطا: ' + e.message);
    }
  }

  async function sendHighFive(classmateId, classmateName) {
    try {
      await apiFetch('/student/send-high-five', { method: 'POST', body: { toStudentId: classmateId, message: 'آفرین! 👋' } });
      alert('های‌فایو به ' + classmateName + ' ارسال شد! ');
      closeModal('highfiveModal');
    } catch (e) {
      alert('خطا: ' + e.message);
    }
  }

  async function loadNotifications() {
    try {
      const data = await apiFetch('/student/list-notifications');
      const container = document.getElementById('notificationsList');
      const count = data.notifications?.filter(n => !n.is_read).length || 0;
      document.getElementById('notifCount').textContent = toFa(count);

      if (!data.notifications || data.notifications.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:20px; color:#718075;">اعلانی نداری 🔔</div>';
        return;
      }

      container.innerHTML = data.notifications.slice(0, 10).map(n => `
        <div class="notification-item ${!n.is_read ? 'unread' : ''}" onclick="markNotificationRead(${n.id})">
          <b>${n.title}</b>
          <small>${n.body}</small>
          <small style="margin-top:6px;">${n.created_at ? formatJalali(n.created_at) : ''}</small>
        </div>
      `).join('');
    } catch (e) {
      document.getElementById('notificationsList').innerHTML = '<div style="color:red;">خطا در بارگذاری اعلان‌ها</div>';
    }
  }

  async function markNotificationRead(id) {
    try {
      await apiFetch('/student/mark-notifications-read', { method: 'POST', body: { notificationId: id } });
      loadNotifications();
    } catch (e) {
      console.error('Error marking notification:', e);
    }
  }

  async function loadChallenges() {
    try {
      const data = await apiFetch('/student/list-daily-challenges');
      if (data.challenges && data.challenges.length > 0) {
        const today = data.challenges[0];
        document.getElementById('challengeTitle').textContent = '🎯 ' + today.title;
        document.getElementById('challengeDesc').textContent = today.description || 'چالش امروز را کامل کن!';
        if (today.completed) {
          document.getElementById('challengeBtn').textContent = '✓ انجام شد';
          document.getElementById('challengeBtn').disabled = true;
        }
      } else {
        document.getElementById('challengeTitle').textContent = '🎯 چالش امروز';
        document.getElementById('challengeDesc').textContent = 'چالش امروز هنوز تعریف نشده';
        document.getElementById('challengeBtn').disabled = true;
      }
    } catch (e) {
      console.error('Error loading challenges:', e);
    }
  }

  async function loadTasks() {
    try {
      const data = await apiFetch('/student/get-tasks');
      const container = document.getElementById('tasksList');

      if (!data.tasks || data.tasks.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:20px; color:#718075;">آفرین! تکلیف بازی نداری </div>';
        return;
      }

      container.innerHTML = data.tasks.map(task => {
        const isDone = task.status === 'submitted' || task.status === 'reviewed';
        const statusClass = isDone ? '' : (task.urgent ? 'urgent' : 'warn');
        const statusText = isDone ? (task.score !== null ? `نمره: ${toFa(task.score)}` : 'ارسال شده') : 'در انتظار';
        
        return `
          <div class="task" onclick="window.location.href='/task.html?id=${task.id}'">
            <div>
              <b>${task.title}</b>
              <small>مهلت: ${task.due_at ? formatJalali(task.due_at) : 'نامحدود'}</small>
            </div>
            <span class="status ${statusClass}">${statusText}</span>
          </div>
        `;
      }).join('');
    } catch (e) {
      document.getElementById('tasksList').innerHTML = '<div style="color:red; text-align:center;">خطا در دریافت تکالیف</div>';
    }
  }

  async function loadAnalytics() {
    try {
      const progress = await apiFetch('/student/get-progress');
      
      document.getElementById('statGrowthPoints').textContent = toFa(progress.growthPoints || 0);
      document.getElementById('statStreak').textContent = toFa(progress.streak || 0);

      const skillsContainer = document.getElementById('skillsList');
      if (progress.skills && progress.skills.length > 0) {
        skillsContainer.innerHTML = progress.skills.slice(0, 3).map(skill => `
          <div class="skill">
            <div class="skill-head">
              <b>${skill.name}</b>
              <span>${toFa(skill.percent)}٪</span>
            </div>
            <div class="progress">
              <div style="width: ${skill.percent}%"></div>
            </div>
          </div>
        `).join('');
      }

      const badgesContainer = document.getElementById('badgesList');
      if (progress.recentBadges && progress.recentBadges.length > 0) {
        badgesContainer.innerHTML = progress.recentBadges.slice(0, 4).map(b => `
          <div class="badge">
            <div>${b.icon}</div>
            ${b.name}
          </div>
        `).join('');
      } else {
        badgesContainer.innerHTML = '<div style="color:#718075; font-size:12px; width:100%; text-align:center;">هنوز دستاوردی کسب نکردی</div>';
      }

      const mastery = progress.mastery || 0;
      const plantIcon = document.getElementById('plantIcon');
      const plantStage = document.getElementById('plantStage');
      
      if (mastery < 30) { plantIcon.textContent = '🌱'; plantStage.textContent = 'رشد یادگیری تو: «جوانه»'; }
      else if (mastery < 60) { plantIcon.textContent = ''; plantStage.textContent = 'رشد یادگیری تو: «ساقهٔ محکم»'; }
      else if (mastery < 85) { plantIcon.textContent = '🌸'; plantStage.textContent = 'رشد یادگیری تو: «شکوفا»'; }
      else { plantIcon.textContent = '🌳'; plantStage.textContent = 'رشد یادگیری تو: «درخت پربار»'; }

    } catch (e) {
      console.error('Error loading analytics:', e);
    }
  }

  async function loadParentNotes() {
    try {
      const data = await apiFetch('/student/list-parent-notes');
      const container = document.getElementById('parentNotesList');
      if (!data.notes || data.notes.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:20px; color:#718075;">هنوز یادداشتی از والدین نداری 💝</div>';
        return;
      }
      container.innerHTML = data.notes.slice(0, 3).map(note => `
        <div class="parent-note">
          <b>📝 ${note.parent_name}</b>
          <div style="margin-top:6px;">${note.note}</div>
          <small>${note.created_at ? formatJalali(note.created_at) : ''}</small>
        </div>
      `).join('');
    } catch (e) {
      document.getElementById('parentNotesList').innerHTML = '<div style="color:red;">خطا در بارگذاری یادداشت‌ها</div>';
    }
  }

  async function loadHighFives() {
    try {
      const data = await apiFetch('/student/list-high-fives');
      const container = document.getElementById('highfivesList');
      if (!data.highFives || data.highFives.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:20px; color:#718075;">هنوز های‌فایویی دریافت نکردی 👋</div>';
        return;
      }
      container.innerHTML = data.highFives.slice(0, 5).map(hf => `
        <div class="highfive-item">
          <div class="highfive-avatar">👋</div>
          <div class="highfive-content">
            <b>از طرف: ${hf.fromName}</b>
            <small>${hf.message || 'یک های‌فایو فرستاد!'}</small>
          </div>
        </div>
      `).join('');
    } catch (e) {
      document.getElementById('highfivesList').innerHTML = '<div style="color:red;">خطا در بارگذاری های‌فایوها</div>';
    }
  }

  async function loadClassmates() {
    try {
      const data = await apiFetch('/student/list-classmates');
      const container = document.getElementById('classmatesList');
      if (!data.classmates || data.classmates.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:20px; color:#718075;">همکلاسی‌ای نداری</div>';
        return;
      }
      container.innerHTML = data.classmates.map(c => `
        <div class="highfive-item">
          <div class="highfive-avatar">${c.avatar || '🧒'}</div>
          <div class="highfive-content">
            <b>${c.full_name}</b>
          </div>
          <button class="send-highfive-btn" onclick="sendHighFive(${c.id}, '${c.full_name}')">ارسال 👋</button>
        </div>
      `).join('');
    } catch (e) {
      document.getElementById('classmatesList').innerHTML = '<div style="color:red;">خطا در بارگذاری همکلاسی‌ها</div>';
    }
  }

  async function loadDiary() {
    try {
      const data = await apiFetch('/student/get-garden-diary');
      const container = document.getElementById('diaryContent');
      if (!data.entries || data.entries.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding:20px; color:#718075;">دفترچه باغچه خالی است 📔</div>';
        return;
      }
      container.innerHTML = data.entries.map(entry => `
        <div class="parent-note">
          <b>${entry.title}</b>
          <div style="margin-top:6px;">${entry.content}</div>
          <small>${entry.created_at ? formatJalali(entry.created_at) : ''}</small>
        </div>
      `).join('');
    } catch (e) {
      document.getElementById('diaryContent').innerHTML = '<div style="color:red;">خطا در بارگذاری دفترچه</div>';
    }
  }

  function logout() {
    if (confirm('آیا مطمئن هستید که می‌خواهید خارج شوید؟')) {
      localStorage.removeItem('auth_token');
      window.location.href = '/login.html';
    }
  }

  // بارگذاری اولیه همه داده‌ها
  loadNotifications();
  loadChallenges();
  loadTasks();
  loadAnalytics();
  loadParentNotes();
  loadHighFives();
</script>
</body>
</html>
